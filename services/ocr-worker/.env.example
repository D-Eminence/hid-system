NODE_ENV=development
OCR_PROVIDER=disabled
OCR_WORKER_DATABASE_URL=postgresql://hid_ocr_worker:change-me@127.0.0.1:5432/hid
# app.actor_subject for every worker command: the subject of an active account holding the platform ocr_worker
# role, or every claim answers 42501. Production uses hid:staging:ocr-worker (seeded by migration 0106); locally,
# seed an account for the value you choose.
OCR_WORKER_SUBJECT=ocr_worker_local
OCR_WORKER_DATABASE_SSL=false
OCR_WORKER_DATABASE_SSL_ROOT_CERT_BASE64=
OCR_WORKER_POOL_MAX=4
OCR_WORKER_CONCURRENCY=2
# Fair claiming (migration 0107): at most this many jobs of one facility processing at once (1-16).
OCR_WORKER_MAX_INFLIGHT_PER_FACILITY=2
OCR_WORKER_POLL_MS=1000
OCR_WORKER_LEASE_SECONDS=300
OCR_WORKER_MAX_OBJECT_BYTES=52428800
OCR_WORKER_API_TIMEOUT_MS=30000
OCR_TEXTRACT_POLL_MS=1500
OCR_TEXTRACT_MAX_POLL_SECONDS=300
AWS_REGION=eu-west-1
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
OCR_TEXTRACT_MAX_RETRIES=3
OCR_TEXTRACT_MAX_PAGES=20
# Textract calls in flight at once for the whole worker process, all claim loops together (1-16).
OCR_TEXTRACT_MAX_CONCURRENT=2
# text (default, cheapest): DetectDocumentText / StartDocumentTextDetection. layout: AnalyzeDocument /
# StartDocumentAnalysis with FeatureTypes LAYOUT only (better reading order, costs more). FORMS and TABLES are never used.
OCR_TEXTRACT_FEATURES=text
# AI reading on the Anthropic Claude API (US-only processing, inference_geo "us"). Off unless set to claude.
# OCR_AI_GLOBAL_PROCESSING_APPROVED (old name) no longer approves anything; use OCR_AI_US_PROCESSING_APPROVED.
OCR_AI_MODE=off
# Injected from the secret store at run time; never commit a value.
ANTHROPIC_API_KEY=
OCR_AI_US_PROCESSING_APPROVED=false
OCR_AI_FIRST_PASS_MODEL=claude-opus-5-5
OCR_AI_FIRST_PASS_EFFORT=high
OCR_AI_REREAD_MODEL=claude-opus-5-5
OCR_AI_REREAD_EFFORT=high
# 64000 leaves room for a hard page read at max effort (Claude Opus 5.5 allows up to 128000 when streamed).
OCR_AI_MAX_TOKENS=64000
OCR_AI_TIMEOUT_MS=300000
OCR_AI_MAX_RETRIES=4
OCR_AI_MAX_REREAD_PAGES=20
# Re-read flagged pages (first-pass flags: low_confidence, handwriting, many_dropped, ai_unsure, possible_missed_item)
# with the picture of the page instead of a text re-read: one-page PNG/JPEG only, US only.
# 'on' or 'off'; empty means 'on' when OCR_AI_MODE=claude and 'off' otherwise. Any other value fails startup.
OCR_AI_IMAGE_REREAD=
# A page whose text had an 11-digit NIN-like or Nigerian phone number hidden: 'send' (default; empty means the
# same; owner decision 2026-11-05) sends the picture anyway, which shows those numbers to the Claude API (US only);
# 'text_only' re-reads such a page from its text only. The text sent stays masked either way. Any other value fails startup.
OCR_AI_IMAGE_MASKED_PAGES=send
# Hard pages (flagged handwriting or low_confidence, re-read with the picture): two best-guess reads per page (owner
# decision 2026-11-05). 'on' or 'off'; empty means 'on' when OCR_AI_MODE=claude. Effort low|medium|high|xhigh|max.
OCR_AI_HARD_PAGE_READS=
# Effort of a hard-page read's first turn: 'high' (owner decision 2026-11-10); set 'max' to compare.
OCR_AI_HARD_PAGE_EFFORT=high
# Effort of a hard-page read's turns after a zoom result (the first turn keeps OCR_AI_HARD_PAGE_EFFORT).
OCR_AI_HARD_PAGE_FOLLOWUP_EFFORT=high
# Output tokens for one hard-page read, all its turns together (4096-128000). Per attempt: a retried turn gets
# the same max_tokens; the deadline below is what bounds a read's billed output (README).
OCR_AI_HARD_PAGE_MAX_TOKENS=32000
# The whole hard page, both reads (30000-1800000 ms): a read still running then is aborted (README).
OCR_AI_HARD_PAGE_DEADLINE_MS=150000
# The last-resort image re-read's own window, in seconds (30-300), from when it is decided: a page with no usable
# reading at all, even one whose two hard reads were both cut by the deadline above, gets one more try (README
# "Last resort"). A hard page's worst case is then about 150 s + 60 s plus the first pass (up to 150 s + 300 s): past
# the 3-minute hard-page target and the website's 3-minute poll (README "Worst case").
OCR_AI_LAST_RESORT_SECONDS=60
# Zoom calls per hard-page read (0-4).
OCR_AI_ZOOM_MAX_CALLS=4
# Per hard-page request attempt, for the whole streamed answer (10000-1800000 ms); the deadline above ends it sooner.
OCR_AI_HARD_PAGE_TIMEOUT_MS=900000
# Claude API requests in flight at once for the whole worker process, all claim loops together (1-32; at least 2
# when the hard-page reads are on, since their two reads run at once).
OCR_AI_MAX_CONCURRENT_REQUESTS=4
# Pages of one document read at once, inside OCR_AI_MAX_CONCURRENT_REQUESTS (1-8).
OCR_AI_PAGE_CONCURRENCY=2
# Emergency off-switch only: comma-separated facility UUIDs (whitespace trimmed, case-insensitive) that may use
# AI reading. Unset or empty means every facility when OCR_AI_MODE=claude. ocr-api reads the same variable:
# give both services the same value.
OCR_AI_FACILITY_IDS=

NODE_ENV=development
OCR_PROVIDER=disabled
OCR_WORKER_DATABASE_URL=postgresql://hid_ocr_worker:change-me@127.0.0.1:5432/hid
OCR_WORKER_SUBJECT=ocr_worker_local
OCR_WORKER_DATABASE_SSL=false
OCR_WORKER_DATABASE_SSL_ROOT_CERT_BASE64=
OCR_WORKER_POOL_MAX=4
OCR_WORKER_CONCURRENCY=2
# Fair claiming (migration 0110): at most this many jobs of one facility processing at once (1-16).
OCR_WORKER_MAX_INFLIGHT_PER_FACILITY=2
OCR_WORKER_POLL_MS=1000
OCR_WORKER_LEASE_SECONDS=300
OCR_WORKER_MAX_OBJECT_BYTES=52428800
OCR_WORKER_API_TIMEOUT_MS=30000
OCR_TEXTRACT_POLL_MS=1500
OCR_TEXTRACT_MAX_POLL_SECONDS=300
AWS_REGION=eu-west-1
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
OCR_TEXTRACT_MAX_RETRIES=3
OCR_TEXTRACT_MAX_PAGES=20
# Textract calls in flight at once for the whole worker process, all claim loops together (1-16).
OCR_TEXTRACT_MAX_CONCURRENT=2
# text (default, cheapest): DetectDocumentText / StartDocumentTextDetection. layout: AnalyzeDocument /
# StartDocumentAnalysis with FeatureTypes LAYOUT only (better reading order, costs more). FORMS and TABLES are never used.
OCR_TEXTRACT_FEATURES=text
# AI reading on the Anthropic Claude API (global processing). Off unless set to claude.
OCR_AI_MODE=off
# Injected from the secret store at run time; never commit a value.
ANTHROPIC_API_KEY=
OCR_AI_GLOBAL_PROCESSING_APPROVED=false
OCR_AI_FIRST_PASS_MODEL=claude-sonnet-5-5
OCR_AI_FIRST_PASS_EFFORT=medium
OCR_AI_REREAD_MODEL=claude-opus-5-5
OCR_AI_REREAD_EFFORT=high
OCR_AI_MAX_TOKENS=16000
OCR_AI_TIMEOUT_MS=180000
OCR_AI_MAX_RETRIES=4
OCR_AI_MAX_REREAD_PAGES=20
# Claude API requests in flight at once for the whole worker process, all claim loops together (1-32).
OCR_AI_MAX_CONCURRENT_REQUESTS=4
# Pages of one document read at once, inside OCR_AI_MAX_CONCURRENT_REQUESTS (1-8).
OCR_AI_PAGE_CONCURRENCY=2
# Emergency off-switch only: comma-separated facility UUIDs (whitespace trimmed, case-insensitive) that may use
# AI reading. Unset or empty means every facility when OCR_AI_MODE=claude. ocr-api reads the same variable:
# give both services the same value.
OCR_AI_FACILITY_IDS=

NODE_ENV=development
OCR_PROVIDER=disabled
OCR_WORKER_DATABASE_URL=postgresql://hid_ocr_worker:change-me@127.0.0.1:5432/hid
OCR_WORKER_SUBJECT=ocr_worker_local
OCR_WORKER_DATABASE_SSL=false
OCR_WORKER_DATABASE_SSL_ROOT_CERT_BASE64=
OCR_WORKER_POOL_MAX=4
OCR_WORKER_CONCURRENCY=2
OCR_WORKER_POLL_MS=1000
OCR_WORKER_LEASE_SECONDS=300
OCR_WORKER_MAX_OBJECT_BYTES=52428800
OCR_WORKER_API_TIMEOUT_MS=30000
OCR_TEXTRACT_POLL_MS=1500
OCR_TEXTRACT_MAX_POLL_SECONDS=300
AWS_REGION=eu-west-1
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

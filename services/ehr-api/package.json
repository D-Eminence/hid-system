{
  "name": "@hid/ehr-api",
  "version": "0.1.0",
  "private": true,
  "description": "Independently runnable HID EHR API",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:local": "nest start",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:plan": "node scripts/apply-migrations.mjs --plan",
    "db:test-staging-upgrade": "node scripts/test-staging-schema-upgrade.mjs",
    "db:dry-run": "node scripts/apply-migrations.mjs --dry-run",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:bootstrap": "node scripts/bootstrap-database-roles.mjs",
    "db:bootstrap:local": "node scripts/bootstrap-database-roles.mjs --local-development-admin",
    "db:verify-roles": "node scripts/bootstrap-database-roles.mjs --verify-only",
    "migration:stage": "node scripts/stage-legacy-identity.mjs",
    "migration:stage:dry-run": "node scripts/stage-legacy-identity.mjs --dry-run",
    "migration:promote": "node scripts/promote-legacy-identity.mjs",
    "migration:staging-additions": "node scripts/promote-staging-cutover-additions.mjs",
    "migration:staging-medical-records": "node scripts/import-staging-medical-records.mjs",
    "migration:staging-customer-import": "node scripts/run-staging-customer-import.mjs",
    "migration:publish-customer-inputs": "node scripts/publish-staging-customer-inputs.mjs",
    "migration:test-customer-inputs": "node --test scripts/customer-import-input.test.mjs scripts/customer-history.test.mjs scripts/configuration-mapping.test.mjs",
    "migration:test-medical-records": "node --test scripts/imported-medical-records.test.mjs",
    "migration:test-staging-additions": "node --test scripts/staging-cutover-additions.test.mjs",
    "migration:reconcile": "node scripts/reconcile-legacy-identity.mjs",
    "migration:verify": "node scripts/verify-legacy-migration.mjs",
    "migration:verify-nin-crosswalk": "node --test scripts/legacy-nin-crosswalk.test.mjs",
    "migration:rekey-contacts": "node scripts/rekey-patient-contact-lookups.mjs",
    "migration:import-nin-crosswalk": "node scripts/import-legacy-nin-crosswalk.mjs",
    "migration:verify-cutover-input": "node scripts/verify-supabase-cutover-input.mjs",
    "admin:bootstrap": "node scripts/bootstrap-platform-admin.mjs",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand"
  },
  "dependencies": {
    "@hid/api-client": "file:../../packages/api-client",
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "jose": "^6.0.11",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "jest": "^30.0.5",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}

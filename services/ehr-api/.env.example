NODE_ENV=development
PORT=3002
IDENTITY_API_URL=http://127.0.0.1:3001
IDENTITY_SERVICE_IDENTITY_MODE=local-secret
IDENTITY_EHR_INTERNAL_SERVICE_TOKEN=local-only-independent-random-secret-at-least-32-characters
# Production: set mode=jwt and mount a rotating Identity-audience token.
IDENTITY_EHR_WORKLOAD_TOKEN_FILE=
# Inbound OCR-to-EHR source and publication boundary.
EHR_SERVICE_IDENTITY_MODE=local-secret
EHR_INTERNAL_SERVICE_TOKEN=local-only-independent-random-secret-at-least-32-characters
# Production: use JWT verification for the exact OCR workload subject.
EHR_WORKLOAD_ISSUER_URL=
EHR_WORKLOAD_AUDIENCE=hid-ehr-api
EHR_WORKLOAD_JWKS_URL=
EHR_OCR_CALLER_SUBJECT=
LAB_API_URL=http://127.0.0.1:3003
LAB_INTERNAL_SERVICE_TOKEN=local-only-independent-random-secret-at-least-32-characters
LAB_SERVICE_IDENTITY_MODE=local-secret
# Production: set mode=jwt and mount the EHR caller's audience-bound token.
LAB_EHR_WORKLOAD_TOKEN_FILE=
PHARMACY_API_URL=http://127.0.0.1:3004
PHARMACY_INTERNAL_SERVICE_TOKEN=local-only-independent-random-secret-at-least-32-characters
PHARMACY_SERVICE_IDENTITY_MODE=local-secret
# Production: set mode=jwt and mount the EHR caller's Pharmacy-audience token.
PHARMACY_EHR_WORKLOAD_TOKEN_FILE=
OUTREACH_IDENTITY_SERVICE_IDENTITY_MODE=local-secret
OUTREACH_IDENTITY_INTERNAL_SERVICE_TOKEN=local-only-independent-random-secret-at-least-32-characters
# Production JWT mode uses the shared HTTPS workload issuer/JWKS/audience below.
OUTREACH_CALLER_SUBJECT=
DATABASE_URL=postgresql://hid_app:change-me@localhost:5432/hid
DATABASE_SSL=false
DATABASE_SSL_ROOT_CERT_BASE64=
DATABASE_POOL_MAX=10
WORKLOAD_DATABASE_URL=
WORKLOAD_DATABASE_POOL_MAX=3
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_CIDRS=
STORAGE_MODE=disabled
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_KMS_KEY_ID=
# Patient record chat (owner decision 1 of 2026-10-16), off by default.
# Required when on: RECORD_CHAT_MODEL_ID (no default; the model comes only
# from this setting), RECORD_CHAT_ANTHROPIC_API_KEY and
# RECORD_CHAT_AUDIT_DIGEST_KEY_B64 (32 bytes, base64; both from the secret
# store), RECORD_CHAT_INFERENCE_GEO (us or global), RECORD_CHAT_NOTICE_VERSION
# and RECORD_CHAT_DAILY_TOKEN_BUDGET. Optional: RECORD_CHAT_API_BASE_URL (the
# first-party origin when unset, and the only one NODE_ENV=production
# accepts), RECORD_CHAT_EFFORT, and the limits below, which have defaults.
# RECORD_CHAT_MAX_RETRIES accepts only 0 (a retry would resend PHI).
# NODE_ENV=production (every deployed environment) also requires
# RECORD_CHAT_PROCESSING_APPROVAL (ADR-NNN@YYYY-MM-DD): an operator's
# attestation, checked for form only, naming the ADR that records the
# processing agreement, geography, retention and quotas (the release
# checklist's record chat row; the record chat design ADR is not that ADR).
# While chat is on, ehr-api refuses to start beside any ANTHROPIC_* variable,
# in every environment.
RECORD_CHAT_PATIENT_ENABLED=false
RECORD_CHAT_MODEL_ID=
RECORD_CHAT_ANTHROPIC_API_KEY=
RECORD_CHAT_API_BASE_URL=
RECORD_CHAT_INFERENCE_GEO=
RECORD_CHAT_PROCESSING_APPROVAL=
RECORD_CHAT_AUDIT_DIGEST_KEY_B64=
RECORD_CHAT_NOTICE_VERSION=
RECORD_CHAT_DAILY_TOKEN_BUDGET=
RECORD_CHAT_MAX_OUTPUT_TOKENS=4096
RECORD_CHAT_DEADLINE_MS=25000
RECORD_CHAT_MAX_RETRIES=0
RECORD_CHAT_MAX_EVIDENCE_CHARS=40000
RECORD_CHAT_EFFORT=

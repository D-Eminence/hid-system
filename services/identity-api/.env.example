NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://identity_service:replace-me@127.0.0.1:5432/hid
DATABASE_SSL=false
DATABASE_SSL_ROOT_CERT_BASE64=
DATABASE_POOL_MAX=10
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_CIDRS=

AUTH_MODE=local
AUTH_SIGNING_SECRET=replace-with-at-least-32-random-characters
AUTH_ISSUER=hid-identity
AUTH_AUDIENCE=hid-api
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=28800
AUTH_ABSOLUTE_TTL_SECONDS=86400
AUTH_LOGIN_PEPPER=replace-with-a-different-32-character-secret
AUTH_LOGIN_PEPPER_VERSION=1
AUTH_COOKIE_NAME=hid_access
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=

# Required when NODE_ENV=production. Production and staging use separate
# Turnstile hostname/action allowlists and independently managed secret values.
HID_DEPLOYMENT_ENV=

# Public site key belongs in VITE_TURNSTILE_SITE_KEY. Only this server-side
# secret is private. Production requires required mode and the real secret.
TURNSTILE_MODE=disabled
TURNSTILE_SECRET_KEY=
TURNSTILE_SITEVERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT_MS=3000

# Dedicated 32-byte base64 key; never reuse signing, login-attempt, or NIN keys.
OTP_HMAC_KEY_B64=
OTP_HMAC_KEY_VERSION=local-v1
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_WINDOW_SECONDS=900
OTP_RATE_MAX_REQUESTS=5
NOTIFICATION_API_URL=http://127.0.0.1:3007
NOTIFICATION_SERVICE_IDENTITY_MODE=local-secret
NOTIFICATION_IDENTITY_INTERNAL_SERVICE_TOKEN=replace-with-an-independent-32-character-secret
NOTIFICATION_IDENTITY_WORKLOAD_TOKEN_FILE=

NIN_PROVIDER_MODE=unavailable
NIN_LOOKUP_HMAC_KEY_B64=
NIN_ENCRYPTION_KEY_B64=
NIN_KEY_VERSION=local-v1

IDENTITY_SERVICE_IDENTITY_MODE=local-secret
IDENTITY_EHR_INTERNAL_SERVICE_TOKEN=replace-with-an-independent-32-character-secret
IDENTITY_LAB_INTERNAL_SERVICE_TOKEN=replace-with-an-independent-32-character-secret
IDENTITY_PHARMACY_INTERNAL_SERVICE_TOKEN=replace-with-an-independent-32-character-secret
IDENTITY_OCR_INTERNAL_SERVICE_TOKEN=replace-with-an-independent-32-character-secret
OUTREACH_IDENTITY_INTERNAL_SERVICE_TOKEN=replace-with-an-independent-32-character-secret

# Production requires an HTTPS issuer/JWKS, the Identity audience, and exact
# deployment-specific subjects. Local secrets above are rejected in production.
WORKLOAD_ISSUER_URL=
WORKLOAD_AUDIENCE=hid-identity-api
WORKLOAD_JWKS_URL=
IDENTITY_EHR_CALLER_SUBJECT=
IDENTITY_LAB_CALLER_SUBJECT=
IDENTITY_PHARMACY_CALLER_SUBJECT=
IDENTITY_OCR_CALLER_SUBJECT=
OUTREACH_CALLER_SUBJECT=

# Private service-status origins used only by the authorized Admin aggregator.
# The browser never receives or calls these values directly.
ADMIN_IDENTITY_STATUS_URL=http://127.0.0.1:3001
ADMIN_EHR_STATUS_URL=http://127.0.0.1:3002
ADMIN_LAB_STATUS_URL=http://127.0.0.1:3003
ADMIN_PHARMACY_STATUS_URL=http://127.0.0.1:3004
ADMIN_OCR_STATUS_URL=http://127.0.0.1:3005
ADMIN_OUTREACH_STATUS_URL=http://127.0.0.1:3006
ADMIN_EVENT_DISPATCHER_STATUS_URL=http://127.0.0.1:3010
ADMIN_OPERATIONS_TIMEOUT_MS=1500

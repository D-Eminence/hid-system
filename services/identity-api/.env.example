NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://identity_service:replace-me@127.0.0.1:5432/hid
DATABASE_SSL=false
DATABASE_SSL_ROOT_CERT_BASE64=
DATABASE_POOL_MAX=10
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_CIDRS=

AUTH_MODE=local
AUTH_SIGNING_SECRET=replace-with-at-least-32-random-characters
AUTH_ISSUER=hid-identity
AUTH_AUDIENCE=hid-api
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=28800
AUTH_ABSOLUTE_TTL_SECONDS=86400
# Patient sessions only: 7 days idle, 30 days at most (owner decision of 2026-10-28).
AUTH_PATIENT_REFRESH_TTL_SECONDS=604800
AUTH_PATIENT_ABSOLUTE_TTL_SECONDS=2592000
AUTH_LOGIN_PEPPER=replace-with-a-different-32-character-secret
AUTH_LOGIN_PEPPER_VERSION=1
AUTH_COOKIE_NAME=hid_access
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=

# Required when NODE_ENV=production. Production and staging use separate
# Turnstile hostname/action allowlists and independently managed secret values.
HID_DEPLOYMENT_ENV=

# Public site key belongs in VITE_TURNSTILE_SITE_KEY. Only this server-side
# secret is private. Production requires required mode and the real secret.
TURNSTILE_MODE=disabled
TURNSTILE_SECRET_KEY=
TURNSTILE_SITEVERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT_MS=3000

# Dedicated 32-byte base64 key; never reuse signing, login-attempt, or NIN keys.
OTP_HMAC_KEY_B64=
CONTACT_LOOKUP_HMAC_KEY_B64=
OTP_HMAC_KEY_VERSION=local-v1
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_WINDOW_SECONDS=900
OTP_RATE_MAX_REQUESTS=5
# Recovery code budget per account, across its challenges and purposes: the
# OTP_VERIFY_FAILURE_MAX-th wrong code within the window refuses every code of
# that account, a correct one too, and sends none for one window.
OTP_VERIFY_FAILURE_MAX=5
OTP_VERIFY_FAILURE_WINDOW_SECONDS=900
NOTIFICATION_API_URL=http://127.0.0.1:3007
NOTIFICATION_SERVICE_IDENTITY_MODE=local-secret
NOTIFICATION_IDENTITY_INTERNAL_SERVICE_TOKEN=replace-with-an-independent-32-character-secret
NOTIFICATION_IDENTITY_WORKLOAD_TOKEN_FILE=
# Emergency contacts. On by default (production sets no value); keep the
# explicit false for local development. While delivery is off, adding a contact
# and sending a verification code answer 409 and no alert is sent;
# notification-api has its own EMERGENCY_CONTACT_DELIVERY_ENABLED, switched on
# before Identity's and off after it.
EMERGENCY_CONTACT_DELIVERY_ENABLED=false
# Comma list, a non-empty subset of email,sms. The email-brevo profile cannot send SMS.
EMERGENCY_CONTACT_CHANNELS=email
# Optional comma list of at most 20 account UUIDs; when set, only these
# accounts may add contacts or send codes. Empty means every patient.
EMERGENCY_CONTACT_PILOT_ACCOUNT_IDS=
# Dispatch interval while delivery is on (0-3600 seconds, default 60; 0 sends no alert).
PATIENT_LIFECYCLE_SWEEP_SECONDS=60
# Patient sharing (0095): code defaults on; production sets neither key. While
# PATIENT_SHARES_ENABLED=false the share routes answer 404 (the website hides
# them); RECORD_ACCESS_EMAIL_ENABLED=false keeps the inbox notice, sends no email.
PATIENT_SHARES_ENABLED=true
RECORD_ACCESS_EMAIL_ENABLED=true
# Delete my account (B5, 0096); a code default, production sets no key. With
# ACCOUNT_DELETION_ENABLED=false the account-deletion routes answer 404 (the
# website hides the card); scheduled deletions still complete.
ACCOUNT_DELETION_ENABLED=true
# Alert call timeout (1000-20000 ms). Verification codes keep the 5 s OTP timeout.
EMERGENCY_CONTACT_ALERT_TIMEOUT_MS=12000

# Optional Google browser sign-in. This is a comma-separated allowlist of
# approved Google Web client IDs, not a client secret. In AWS it is injected
# only into Identity API from the `googleOidcClientIds` field of the existing
# IdentitySensitiveSecretArn JSON; the matching public browser value is
# VITE_GOOGLE_CLIENT_ID and must be configured through the approved frontend
# build process, never copied into this server-side file.
GOOGLE_OIDC_CLIENT_IDS=

NIN_PROVIDER_MODE=unavailable
# Staging sets HID_DEPLOYMENT_ENV=staging and NIN_PROVIDER_MODE=deferred.
# MetaMap NIN integration is prepared but deferred. Activation requires
# version-specific provider contract confirmation and authorized trial/test access.
# No MetaMap credentials or NIN encryption/HMAC keys are required by the
# deferred staging runtime. Existing key material and tooling remain preserved.
# Designated staging secret: /hid/staging/nin-metamap, JSON clientId/clientSecret.
# Use scripts/staging-metamap-secret.py --store from a local terminal; never put
# the Client Secret in this file. See docs/METAMAP_NIN_CONTRACT.md.
# QoreID is server-only and disabled unless an approved staging activation
# injects its separate Secrets Manager JSON fields (clientId and secret).
# Never use a VITE_/NEXT_PUBLIC_ prefix or commit actual credentials.
QOREID_ENABLED=false
QOREID_NIN_ONLY_ENROLLMENT_ENABLED=false
# The signed-in "Verify NIN" binds on a name and date-of-birth match with no
# proof of holding the NIN. On when unset (owner decision of 2026-10-27: sign-up
# has no NIN; this is how a patient adds one later); 'false' turns it off.
QOREID_PATIENT_SELF_NIN_BINDING_ENABLED=true
QOREID_BASE_URL=https://api.qoreid.com
QOREID_TIMEOUT_MS=5000
# QoreID POSTs have no approved idempotency contract, so automatic retry is off.
QOREID_MAX_RETRIES=0
QOREID_CLIENT_ID=
QOREID_CLIENT_SECRET=
NIN_LOOKUP_HMAC_KEY_B64=
NIN_ENCRYPTION_KEY_B64=
NIN_KEY_VERSION=local-v1
# Public enrollment contact-code budget per recipient, across its challenges
# and enrollments: the PATIENT_ENROLLMENT_CONTACT_FAILURE_MAX-th wrong code
# within the window refuses every code for that recipient, a correct one too,
# and the contact step sends it none, for one window (2-10; 900-86400 s).
PATIENT_ENROLLMENT_CONTACT_FAILURE_MAX=5
PATIENT_ENROLLMENT_CONTACT_FAILURE_WINDOW_SECONDS=900

IDENTITY_SERVICE_IDENTITY_MODE=local-secret
IDENTITY_EHR_INTERNAL_SERVICE_TOKEN=replace-with-an-independent-32-character-secret
IDENTITY_LAB_INTERNAL_SERVICE_TOKEN=replace-with-an-independent-32-character-secret
IDENTITY_PHARMACY_INTERNAL_SERVICE_TOKEN=replace-with-an-independent-32-character-secret
IDENTITY_OCR_INTERNAL_SERVICE_TOKEN=replace-with-an-independent-32-character-secret
OUTREACH_IDENTITY_INTERNAL_SERVICE_TOKEN=replace-with-an-independent-32-character-secret

# Production requires an HTTPS issuer/JWKS, the Identity audience, and exact
# deployment-specific subjects. Local secrets above are rejected in production.
WORKLOAD_ISSUER_URL=
WORKLOAD_AUDIENCE=hid-identity-api
WORKLOAD_JWKS_URL=
IDENTITY_EHR_CALLER_SUBJECT=
IDENTITY_LAB_CALLER_SUBJECT=
IDENTITY_PHARMACY_CALLER_SUBJECT=
IDENTITY_OCR_CALLER_SUBJECT=
OUTREACH_CALLER_SUBJECT=

# Private service-status origins used only by the authorized Admin aggregator.
# The browser never receives or calls these values directly.
ADMIN_IDENTITY_STATUS_URL=http://127.0.0.1:3001
ADMIN_EHR_STATUS_URL=http://127.0.0.1:3002
ADMIN_LAB_STATUS_URL=http://127.0.0.1:3003
ADMIN_PHARMACY_STATUS_URL=http://127.0.0.1:3004
ADMIN_OCR_STATUS_URL=http://127.0.0.1:3005
ADMIN_OUTREACH_STATUS_URL=http://127.0.0.1:3006
ADMIN_EVENT_DISPATCHER_STATUS_URL=http://127.0.0.1:3010
ADMIN_OPERATIONS_TIMEOUT_MS=1500

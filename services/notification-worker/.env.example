NODE_ENV=development
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_WORKER_ID=notification-worker-local
NOTIFICATION_WORKER_STATUS_HOST=127.0.0.1
NOTIFICATION_WORKER_STATUS_PORT=3008
NOTIFICATION_WORKER_DATABASE_URL=postgresql://notification_worker:replace-me@127.0.0.1:5432/hid
NOTIFICATION_WORKER_DATABASE_POOL_MAX=4
NOTIFICATION_WORKER_DATABASE_SSL=false
NOTIFICATION_WORKER_DATABASE_SSL_ROOT_CERT_BASE64=
NOTIFICATION_WORKER_QUEUE_URL=
NOTIFICATION_WORKER_MAX_ATTEMPTS=8
NOTIFICATION_WORKER_LEASE_SECONDS=60
AWS_REGION=eu-west-1
AWS_ENDPOINT_URL=

NOVU_MODE=disabled
NOVU_API_URL=https://api.novu.co
NOVU_API_KEY=

# FCM credentials stay server-side and external. The adapter accepts a
# short-lived access token from the workload credential provider.
FCM_PROJECT_ID=
FCM_API_URL=https://fcm.googleapis.com

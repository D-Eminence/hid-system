PORT=3011
AWS_REGION=eu-west-1
LEX_BOT_ID=
LEX_BOT_ALIAS_ID=
LEX_LOCALE_ID=en_GB
# Approved public escalation route. Do not substitute a controlled test recipient.
SUPPORT_CONTACT=
# Uses the task IAM role in AWS; no AWS keys or database. The only identity input is the
# Health ID check below, which sends identity-api only the strings that could be a Health ID.
# Server Health ID check (0109): identity-api's internal origin, and support-api's
# workload token written by the workload-token-agent sidecar. Without the URL or
# the token every message answers 503 and nothing reaches Lex. local-secret is
# for local development only (refused in production).
IDENTITY_API_URL=
IDENTITY_SERVICE_IDENTITY_MODE=jwt
IDENTITY_SUPPORT_WORKLOAD_TOKEN_FILE=/var/run/hid/workload-tokens/identity.jwt
IDENTITY_SUPPORT_INTERNAL_SERVICE_TOKEN=

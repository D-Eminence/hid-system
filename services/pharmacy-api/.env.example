NODE_ENV=development
PORT=3004
PHARMACY_DATABASE_URL=postgresql://pharmacy_service:replace-me@127.0.0.1:5432/hid
IDENTITY_API_URL=http://127.0.0.1:3001
IDENTITY_SERVICE_IDENTITY_MODE=local-secret
IDENTITY_PHARMACY_INTERNAL_SERVICE_TOKEN=local-only-independent-random-secret-at-least-32-characters
# Production: set mode=jwt and mount a rotating Identity-audience token.
IDENTITY_PHARMACY_WORKLOAD_TOKEN_FILE=
PHARMACY_INTERNAL_SERVICE_TOKEN=local-only-independent-random-secret-at-least-32-characters
PHARMACY_SERVICE_IDENTITY_MODE=local-secret
# Production JWT verification (local shared secret is rejected in production):
PHARMACY_WORKLOAD_ISSUER_URL=
PHARMACY_WORKLOAD_AUDIENCE=hid-pharmacy-api
PHARMACY_WORKLOAD_JWKS_URL=
PHARMACY_EHR_CALLER_SUBJECT=
PHARMACY_OCR_CALLER_SUBJECT=
DATABASE_SSL=false
DATABASE_SSL_ROOT_CERT_BASE64=
DATABASE_POOL_MAX=10
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_CIDRS=

NODE_ENV=development
PORT=3006
OUTREACH_DATABASE_URL=postgresql://outreach_service:replace-me@127.0.0.1:5432/hid
IDENTITY_API_URL=http://127.0.0.1:3001
OUTREACH_IDENTITY_SERVICE_IDENTITY_MODE=local-secret
OUTREACH_IDENTITY_INTERNAL_SERVICE_TOKEN=local-only-independent-random-secret-at-least-32-characters
# Production: mount a rotating JWT minted for subject `outreach-api` and the
# configured WORKLOAD_AUDIENCE; the Identity API validates issuer/audience/JWKS.
OUTREACH_IDENTITY_WORKLOAD_TOKEN_FILE=
DATABASE_SSL=false
DATABASE_SSL_ROOT_CERT_BASE64=
DATABASE_POOL_MAX=10
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_CIDRS=

EVENT_DISPATCHER_MAX_ATTEMPTS=8
EVENT_DISPATCHER_RETRY_BASE_MS=1000
EVENT_DISPATCHER_RETRY_MAX_MS=300000
EVENT_DISPATCHER_TRANSPORT_TIMEOUT_MS=10000
EVENT_DISPATCHER_DRAIN_TIMEOUT_MS=30000

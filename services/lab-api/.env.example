NODE_ENV=development
PORT=3003
LAB_DATABASE_URL=postgresql://lab_service:replace-me@127.0.0.1:5432/hid
IDENTITY_API_URL=http://127.0.0.1:3001
IDENTITY_SERVICE_IDENTITY_MODE=local-secret
IDENTITY_LAB_INTERNAL_SERVICE_TOKEN=local-only-independent-random-secret-at-least-32-characters
# Production: set mode=jwt and mount a rotating Identity-audience token.
IDENTITY_LAB_WORKLOAD_TOKEN_FILE=
LAB_INTERNAL_SERVICE_TOKEN=local-only-independent-random-secret-at-least-32-characters
LAB_SERVICE_IDENTITY_MODE=local-secret
# Production JWT verification (local shared secret is rejected in production):
LAB_WORKLOAD_ISSUER_URL=
LAB_WORKLOAD_AUDIENCE=hid-lab-api
LAB_WORKLOAD_JWKS_URL=
LAB_EHR_CALLER_SUBJECT=
LAB_OCR_CALLER_SUBJECT=
DATABASE_SSL=false
DATABASE_SSL_ROOT_CERT_BASE64=
DATABASE_POOL_MAX=10
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_CIDRS=

NODE_ENV=development
HID_DEPLOYMENT_ENV=development
PORT=3007
NOTIFICATION_PROVIDER_MODE=disabled
# Profiles: email-only (SES), email-brevo, email-sms-brevo, full (includes WhatsApp).
NOTIFICATION_DELIVERY_PROFILE=full
NOTIFICATION_PROVIDER_TIMEOUT_MS=5000
NOTIFICATION_WORKLOAD_IDENTITY_MODE=local-secret
NOTIFICATION_IDENTITY_INTERNAL_SERVICE_TOKEN=
WORKLOAD_ISSUER_URL=
WORKLOAD_JWKS_URL=
WORKLOAD_AUDIENCE=hid-notification-api
IDENTITY_CALLER_SUBJECT=
AWS_REGION=
SES_FROM_ADDRESS=
TERMII_BASE_URL=https://v4.api.termii.com/
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_CHANNEL=generic
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v25.0
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_OTP_TEMPLATE_NAME=
META_OTP_TEMPLATE_LANGUAGE=en_US
# Brevo is required by email-brevo and email-sms-brevo. Configure only senders
# for enabled channels; email-only uses SES without Brevo.
BREVO_API_KEY=
BREVO_EMAIL_FROM=
BREVO_SMS_SENDER=
BREVO_WHATSAPP_SENDER=

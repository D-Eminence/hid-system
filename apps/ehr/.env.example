# Leave empty when the API is reverse-proxied on the same origin.
VITE_HID_API_URL=

# Must match the backend AUTH_COOKIE_NAME so the double-submit CSRF token can
# bootstrap a one-time session refresh after an access-cookie expiry.
VITE_HID_AUTH_COOKIE_NAME=hid_access

# Optional HTTPS URL for the separately authorized HID Identity registration UI.
VITE_HID_IDENTITY_PORTAL_URL=

# Development-only workflow simulator. Keep false or unset outside local testing.
VITE_HID_DEMO_MODE=false

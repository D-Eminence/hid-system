{
  "name": "hid-system",
  "version": "1.0.0",
  "private": true,
  "description": "HID platform monorepo",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "pretest": "npm run build:test-prerequisites",
    "build:test-prerequisites": "npm run build:api-client",
    "preverify": "npm run build:verification-prerequisites",
    "build:verification-prerequisites": "npm run build:cloudflare && npm run build:container-verification-prerequisites",
    "build:container-verification-prerequisites": "npm run build:identity-api && npm run build:ehr-api && npm run build:lab-api && npm run build:pharmacy-api && npm run build:ocr-api && npm run build:ocr-worker && npm run build:outreach-api && npm run build:notification-api && npm run build:notification-worker && npm run build:event-dispatcher",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:api-client && npm run build:offline && npm run build:telemetry && npm run build:web && npm run build:ehr && npm run build:lab && npm run build:pharmacy && npm run build:ocr && npm run build:outreach && npm run build:admin && npm run build:identity-api && npm run build:ehr-api && npm run build:lab-api && npm run build:pharmacy-api && npm run build:ocr-api && npm run build:ocr-worker && npm run build:outreach-api && npm run build:notification-api && npm run build:notification-worker && npm run build:event-dispatcher && npm run build:infra",
    "test": "npm run test:cloudflare && npm run test:admin && npm run test:pharmacy && npm run test:ocr && npm run test:identity-api && npm run test:ehr-api && npm run test:lab-api && npm run test:pharmacy-api && npm run test:ocr-api && npm run test:ocr-worker && npm run test:outreach-api && npm run test:notification-api && npm run test:notification-worker && npm run test:event-dispatcher && npm run test:infra",
    "verify": "npm run verify:convergence && npm run verify:secret-readiness && npm run verify:migration-ledger && npm run verify:migration && npm run verify:cloudflare && npm run verify:identity && npm run verify:outreach && npm run verify:offline && npm run verify:telemetry && npm run verify:platform-graph && npm run verify:frontends && npm run verify:containers && npm run verify:infra",
    "build:api-client": "npm --prefix packages/api-client run build",
    "build:offline": "npm --prefix packages/offline run build",
    "build:telemetry": "npm --prefix packages/telemetry run build",
    "build:web": "npm --prefix apps/web run build",
    "build:admin": "npm --prefix apps/admin run build",
    "build:cloudflare:web": "HID_PUBLIC_BASE=/ npm --prefix apps/web run build",
    "build:cloudflare:ehr": "HID_PUBLIC_BASE=/ npm --prefix apps/ehr run build",
    "build:cloudflare:lab": "HID_PUBLIC_BASE=/ npm --prefix apps/lab run build",
    "build:cloudflare:pharmacy": "HID_PUBLIC_BASE=/ npm --prefix apps/pharmacy run build",
    "build:cloudflare:ocr": "HID_PUBLIC_BASE=/ npm --prefix apps/ocr run build",
    "build:cloudflare:outreach": "HID_PUBLIC_BASE=/ npm --prefix apps/outreach run build",
    "build:cloudflare:admin": "HID_PUBLIC_BASE=/ npm --prefix apps/admin run build",
    "build:cloudflare": "npm run build:api-client && npm run build:offline && npm run build:telemetry && npm run build:cloudflare:web && npm run build:cloudflare:ehr && npm run build:cloudflare:lab && npm run build:cloudflare:pharmacy && npm run build:cloudflare:ocr && npm run build:cloudflare:outreach && npm run build:cloudflare:admin",
    "build:identity-api": "npm --prefix services/identity-api run build",
    "build:ehr": "npm --prefix apps/ehr run build",
    "build:lab": "npm --prefix apps/lab run build",
    "build:pharmacy": "npm --prefix apps/pharmacy run build",
    "build:ocr": "npm --prefix apps/ocr run build",
    "build:outreach": "npm --prefix apps/outreach run build",
    "build:ehr-api": "npm --prefix services/ehr-api run build",
    "build:lab-api": "npm --prefix services/lab-api run build",
    "build:pharmacy-api": "npm --prefix services/pharmacy-api run build",
    "build:ocr-api": "npm --prefix services/ocr-api run build",
    "build:ocr-worker": "npm --prefix services/ocr-worker run build",
    "build:outreach-api": "npm --prefix services/outreach-api run build",
    "build:event-dispatcher": "npm --prefix services/event-dispatcher run build",
    "build:notification-api": "npm --prefix services/notification-api run build",
    "build:notification-worker": "npm --prefix services/notification-worker run build",
    "build:infra": "npm --prefix infra/aws run build",
    "dev:web": "HID_WEB_DIRECT=true npm --prefix apps/web run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "dev:identity-api": "npm --prefix services/identity-api run start:dev",
    "dev:ehr": "npm --prefix apps/ehr run dev",
    "dev:lab": "npm --prefix apps/lab run dev",
    "dev:pharmacy": "npm --prefix apps/pharmacy run dev",
    "dev:ocr": "npm --prefix apps/ocr run dev",
    "dev:outreach": "npm --prefix apps/outreach run dev",
    "dev:frontends": "HID_BACKENDS_DISABLED=true npm run dev",
    "preview:frontends": "node scripts/preview-frontends.mjs",
    "acceptance:container:database": "bash scripts/run-container-database-acceptance.sh",
    "acceptance:frontend:browser": "node scripts/run-frontend-browser-acceptance.mjs",
    "dev:clinical": "HID_FRONTEND_APPS=web,ehr,lab,pharmacy,ocr npm run dev",
    "dev:ehr-api": "npm --prefix services/ehr-api run start:dev",
    "dev:lab-api": "npm --prefix services/lab-api run start:dev",
    "dev:pharmacy-api": "npm --prefix services/pharmacy-api run start:dev",
    "dev:ocr-api": "npm --prefix services/ocr-api run start:dev",
    "dev:ocr-worker": "npm --prefix services/ocr-worker run start:dev",
    "dev:outreach-api": "npm --prefix services/outreach-api run start:dev",
    "dev:event-dispatcher": "npm --prefix services/event-dispatcher run start:dev",
    "dev:notification-api": "npm --prefix services/notification-api run start:dev",
    "dev:notification-worker": "npm --prefix services/notification-worker run start:dev",
    "test:ehr-api": "npm --prefix services/ehr-api test",
    "test:identity-api": "npm --prefix services/identity-api test",
    "test:admin": "npm --prefix apps/admin test",
    "test:pharmacy": "npm --prefix apps/pharmacy test",
    "test:ocr": "npm --prefix apps/ocr test",
    "test:lab-api": "npm --prefix services/lab-api test",
    "test:pharmacy-api": "npm --prefix services/pharmacy-api test",
    "test:ocr-api": "npm --prefix services/ocr-api test",
    "test:ocr-worker": "npm --prefix services/ocr-worker test",
    "test:outreach-api": "npm --prefix services/outreach-api test",
    "test:event-dispatcher": "npm --prefix services/event-dispatcher test",
    "test:notification-api": "npm --prefix services/notification-api test",
    "test:notification-worker": "npm --prefix services/notification-worker test",
    "test:cloudflare": "npm --prefix infra/cloudflare test",
    "test:infra": "npm --prefix infra/aws test",
    "verify:platform-graph": "node scripts/verify-platform-graph.mjs",
    "verify:convergence": "node scripts/verify-production-convergence.mjs",
    "verify:secret-readiness": "node scripts/verify-secret-readiness.mjs",
    "verify:migration-ledger": "node scripts/verify-migration-ledger.mjs",
    "verify:prebaseline-git": "bash scripts/verify-prebaseline-git.sh",
    "verify:migration": "npm --prefix services/ehr-api run migration:verify",
    "verify:containers": "node scripts/verify-container-platform.mjs",
    "verify:identity": "npm --prefix apps/web run verify:identity",
    "verify:outreach": "npm --prefix apps/outreach run verify:outreach",
    "verify:frontends": "node scripts/verify-frontend-platform.mjs",
    "verify:offline": "npm --prefix packages/offline run verify",
    "verify:telemetry": "npm --prefix packages/telemetry run verify",
    "verify:infra": "npm --prefix infra/aws run lint && npm --prefix infra/aws run cost:inventory:check && npm --prefix infra/aws run synth && npm --prefix infra/aws run verify:synth && npm --prefix infra/aws run verify:policy",
    "verify:cloudflare": "npm --prefix infra/cloudflare run verify",
    "staging:start": "npm --prefix infra/aws run staging:start",
    "staging:sleep": "npm --prefix infra/aws run staging:sleep",
    "staging:fidelity:enable": "npm --prefix infra/aws run staging:fidelity:enable",
    "staging:fidelity:disable": "npm --prefix infra/aws run staging:fidelity:disable",
    "staging:teardown": "npm --prefix infra/aws run staging:teardown",
    "aws:cost-inventory": "npm --prefix infra/aws run cost:inventory:check"
  }
}

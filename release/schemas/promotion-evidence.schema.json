{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://updates.healthidentitydirectory.com/schemas/promotion-evidence.schema.json",
  "title": "HID staging and production promotion evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_type", "environment", "subject_release_id", "artifact_set_sha256", "status", "started_at", "completed_at", "executor", "checks"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "evidence_type": { "enum": ["staging-acceptance", "migration-dry-run", "staging-copy-migration", "backup-restore", "rollback-drill", "approval"] },
    "environment": { "enum": ["staging", "production"] },
    "subject_release_id": { "type": "string", "pattern": "^r[0-9]{10}-g[a-f0-9]{40}$" },
    "artifact_set_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "const": "passed" },
    "started_at": { "$ref": "#/$defs/canonicalDateTime" },
    "completed_at": { "$ref": "#/$defs/canonicalDateTime" },
    "executor": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,127}$" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/check" }
    },
    "authorization": { "$ref": "#/$defs/authorization" }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "evidence_type": { "const": "approval" } }, "required": ["evidence_type"] },
      "then": {
        "type": "object",
        "properties": { "environment": { "const": "production" }, "authorization": { "$ref": "#/$defs/authorization" } },
        "required": ["authorization"]
      },
      "else": {
        "type": "object",
        "properties": { "environment": { "const": "staging" }, "authorization": { "$ref": "#/$defs/authorization" } },
        "not": { "type": "object", "properties": { "authorization": true }, "required": ["authorization"] }
      }
    }
  ],
  "$defs": {
    "canonicalDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
        "status": { "const": "passed" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_id", "approved_by", "approved_at", "expires_at", "scope"],
      "properties": {
        "approval_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$" },
        "approved_by": { "type": "string", "minLength": 3, "maxLength": 128 },
        "approved_at": { "$ref": "#/$defs/canonicalDateTime" },
        "expires_at": { "$ref": "#/$defs/canonicalDateTime" },
        "scope": { "const": "production-promotion" }
      }
    }
  }
}

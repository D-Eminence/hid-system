{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://updates.healthidentitydirectory.com/schemas/channel.schema.json",
  "title": "HID discovery-only current release channel",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "release_id", "release_sequence", "artifact_set_sha256", "release_bundle", "updated_at", "discovery_only"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "environment": { "enum": ["staging", "production"] },
    "release_id": { "type": "string", "pattern": "^r[0-9]{10}-g[a-f0-9]{40}$" },
    "release_sequence": { "type": "integer", "minimum": 1, "maximum": 9999999999 },
    "artifact_set_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "release_bundle": { "$ref": "#/$defs/bundleTarget" },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "discovery_only": { "const": true }
  },
  "$defs": {
    "bundleTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "length", "sha256", "media_type"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^environments/(staging|production)/releases/r[0-9]{10}-g[a-f0-9]{40}/release-bundle\\.json$"
        },
        "length": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "media_type": { "const": "application/vnd.hid.release-bundle+json" }
      }
    }
  }
}

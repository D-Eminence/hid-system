{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node",
    "lib": ["ES2022"], "types": ["node"], "strict": true, "declaration": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true, "outDir": "dist", "rootDir": "src", "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}

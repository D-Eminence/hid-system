aws_region          = "REPLACE_WITH_APPROVED_REGION"
expected_account_id = "REPLACE_WITH_AWS_ACCOUNT_ID"
environment         = "prod"

vpc_cidr            = "10.60.0.0/16"
public_subnet_cidrs = ["10.60.0.0/24", "10.60.1.0/24"]
app_subnet_cidrs    = ["10.60.10.0/24", "10.60.11.0/24"]
data_subnet_cidrs   = ["10.60.20.0/24", "10.60.21.0/24"]

# These remain false until staging acceptance and the production plan review.
enable_nat           = false
enable_database      = false
enable_application   = false
enable_provider_api  = false
enable_opensearch    = false

# Enable from exactly one stack in the AWS account after confirming ownership.
enable_account_trail = false

# Copy only approved production values from the dev template. Production uses
# Multi-AZ RDS, at least two ECS tasks, and one NAT gateway per AZ when enabled.

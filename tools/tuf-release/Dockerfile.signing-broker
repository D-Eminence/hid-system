# syntax=docker.io/docker/dockerfile:1.7.1@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

# Both values are mandatory full image references ending in @sha256:<digest>.
# The reviewed build invocation records those two digests with the resulting
# ECR image digest; this Dockerfile intentionally supplies no mutable default.
ARG GO_BUILD_IMAGE
ARG LAMBDA_RUNTIME_IMAGE
FROM ${GO_BUILD_IMAGE} AS build

ARG GO_BUILD_IMAGE
ARG LAMBDA_RUNTIME_IMAGE
RUN test "${GO_BUILD_IMAGE}" = "docker.io/library/golang:1.26.9-bookworm@sha256:d9c68c2c51161e12fd77e4c6320687c9cd86e1af1e3ad6e6cd63ff970641453c" \
    && test "${LAMBDA_RUNTIME_IMAGE}" = "public.ecr.aws/lambda/provided:al2023@sha256:7dea43facdd67ffd71aa540527b6af413dfdae0133a0423ee9c329bf1e5adb6c"

WORKDIR /src
ENV CGO_ENABLED=0 \
    GOARCH=amd64 \
    GOAMD64=v1 \
    GOENV=off \
    GOOS=linux \
    GOTOOLCHAIN=local

COPY go.mod go.sum ./
RUN test "$(go env GOVERSION)" = "go1.26.9" && go mod download && go mod verify
COPY . ./
RUN go build \
      -mod=readonly \
      -trimpath \
      -buildvcs=false \
      -ldflags=-buildid= \
      -o /out/bootstrap \
      ./cmd/hid-tuf-signing-broker

FROM ${LAMBDA_RUNTIME_IMAGE}

COPY --from=build --chmod=0555 /out/bootstrap /var/runtime/bootstrap
ENTRYPOINT ["/var/runtime/bootstrap"]

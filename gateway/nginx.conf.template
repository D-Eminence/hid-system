# HID API gateway. The image's entrypoint renders this file with envsubst into
# /etc/nginx/conf.d/default.conf, which nginx includes in its http block. Each
# braced dollar reference is an environment variable; the Dockerfile defines a
# local default for every one, because envsubst leaves undefined names in place.

# Client address. Only the public ALB connects to the gateway, from inside the
# VPC, and the WAF admits only requests carrying the Cloudflare Worker's origin
# secret, so X-Real-IP on such a connection is the address the Worker took from
# CF-Connecting-IP. Workers built before this header was set delete a caller's
# X-Real-IP, so behind a stale Worker the header is absent and the request is
# refused rather than trusted. The server block's realip directives make it
# $remote_addr. When the header is missing or unusable, $remote_addr stays the
# load balancer's VPC address, which this flags.
geo $hid_client_address_internal {
  default 0;
  ${VPC_CIDR} 1;
}

# HID_REQUIRE_CLIENT_IP: only the exact value "false" (local runs) lets an API
# request through without a client address; any other value requires it.
map "${HID_REQUIRE_CLIENT_IP}:$hid_client_address_internal" $hid_client_address_missing {
  default 0;
  "~^false:" 0;
  "~:1$" 1;
}

# Request targets nginx and the backends would read differently. Express's
# parseurl hands a target holding '#' to Node's url.parse, which turns every
# backslash before the query into '/'; nginx keeps a backslash and ends its URI
# at '#'. So a backslash in the path, or a '#' anywhere, could reach a route
# that a location below denies. A browser never sends either through the
# Worker (its URL parser turns a path backslash into '/' and never sends a
# fragment), so hid-proxy-headers.conf refuses both.
map $request_uri $hid_request_target_invalid {
  default 0;
  "~^[^?]*\\\\" 1;
  "~#" 1;
}

# HID_ENABLED_API_ROUTES: the comma-separated modules whose routes are proxied.
# A module that is not named exactly answers 404 API_ROUTE_NOT_FOUND. Identity
# owns /api/v1/auth, /identity, /audit, /admin and /commercial.
map "${HID_ENABLED_API_ROUTES}" $hid_identity_routes {
  default off;
  "~(?:^|,)\s*identity\s*(?:,|$)" on;
}
map "${HID_ENABLED_API_ROUTES}" $hid_ehr_routes {
  default off;
  "~(?:^|,)\s*ehr\s*(?:,|$)" on;
}
map "${HID_ENABLED_API_ROUTES}" $hid_lab_routes {
  default off;
  "~(?:^|,)\s*lab\s*(?:,|$)" on;
}
map "${HID_ENABLED_API_ROUTES}" $hid_pharmacy_routes {
  default off;
  "~(?:^|,)\s*pharmacy\s*(?:,|$)" on;
}
map "${HID_ENABLED_API_ROUTES}" $hid_ocr_routes {
  default off;
  "~(?:^|,)\s*ocr\s*(?:,|$)" on;
}
map "${HID_ENABLED_API_ROUTES}" $hid_outreach_routes {
  default off;
  "~(?:^|,)\s*outreach\s*(?:,|$)" on;
}

server {
  listen 3000;
  server_name _;
  server_tokens off;
  # For the answers the gateway writes itself; proxied responses keep the
  # backend's Content-Type.
  default_type application/problem+json;

  set_real_ip_from ${VPC_CIDR};
  real_ip_header X-Real-IP;

  # Upstream names are Cloud Map A records: they change when a task is
  # replaced and do not exist while a module runs no task. Each location sets
  # $hid_upstream and proxies to the variable, so nginx resolves the name per
  # request through this resolver (answers cached for 10 s) instead of once at
  # start-up, and starts even when a name does not resolve; such a request
  # answers 503 UPSTREAM_UNAVAILABLE. The upstream value names no URI part, so
  # the client's request URI is passed unchanged, as with a literal proxy_pass.
  resolver ${GATEWAY_DNS_RESOLVER} valid=10s ipv6=off;
  resolver_timeout 5s;

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Cross-Origin-Opener-Policy "same-origin" always;

  location = /gateway-health/live {
    access_log off;
    default_type application/json;
    return 200 '{"status":"ok"}';
  }

  location = /gateway-health/ready {
    access_log off;
    default_type application/json;
    return 200 '{"status":"ready"}';
  }

  error_page 502 503 504 = @upstream_unavailable;
  location @upstream_unavailable {
    default_type application/problem+json;
    add_header Cache-Control "no-store" always;
    return 503 '{"type":"about:blank","title":"Service unavailable","status":503,"detail":"A required platform service is temporarily unavailable.","code":"UPSTREAM_UNAVAILABLE"}';
  }

  # Every proxied location: the module switch, then hid-proxy-headers.conf
  # (which refuses a backslash or '#' in the request target and a request
  # without a client address), then its owner. Service-to-service routes are
  # called on private service names and never through this gateway. Express
  # matches routes without regard to case or a trailing slash, so each prefix
  # denies them with a case-insensitive nested location, which a ^~ prefix
  # still consults; nginx matches the decoded, normalized URI, so dot segments,
  # repeated slashes and percent-encodings are denied too.
  location = /api/v1/auth {
    if ($hid_identity_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${IDENTITY_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }
  location ^~ /api/v1/auth/ {
    location ~* ^/api/v1/auth/service-session(?:/|$) {
      add_header Cache-Control "no-store" always;
      return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}';
    }
    if ($hid_identity_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${IDENTITY_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }
  location = /api/v1/identity {
    if ($hid_identity_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${IDENTITY_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }
  location ^~ /api/v1/identity/ {
    location ~* ^/api/v1/identity/(?:service|outreach)(?:/|$) {
      add_header Cache-Control "no-store" always;
      return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}';
    }
    if ($hid_identity_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${IDENTITY_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }
  location = /api/v1/audit {
    if ($hid_identity_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${IDENTITY_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }
  location ^~ /api/v1/audit/ {
    if ($hid_identity_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${IDENTITY_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }
  location = /api/v1/admin {
    if ($hid_identity_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${IDENTITY_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }
  location ^~ /api/v1/admin/ {
    if ($hid_identity_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${IDENTITY_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }
  location = /api/v1/commercial {
    if ($hid_identity_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${IDENTITY_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }
  location ^~ /api/v1/commercial/ {
    if ($hid_identity_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${IDENTITY_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }

  location = /api/v1/lab {
    if ($hid_lab_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${LAB_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }
  location ^~ /api/v1/lab/ {
    location ~* ^/api/v1/lab/(?:work-items/accept-ehr-order|imports/from-ocr)(?:/|$) {
      add_header Cache-Control "no-store" always;
      return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}';
    }
    if ($hid_lab_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${LAB_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }
  location = /api/v1/pharmacy {
    if ($hid_pharmacy_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${PHARMACY_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }
  location ^~ /api/v1/pharmacy/ {
    location ~* ^/api/v1/pharmacy/(?:work-items/accept-ehr-prescription|imports/from-ocr)(?:/|$) {
      add_header Cache-Control "no-store" always;
      return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}';
    }
    if ($hid_pharmacy_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${PHARMACY_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }
  location = /api/v1/ocr {
    if ($hid_ocr_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${OCR_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }
  location ^~ /api/v1/ocr/ {
    if ($hid_ocr_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${OCR_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }
  location = /api/v1/outreach {
    if ($hid_outreach_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${OUTREACH_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }
  location ^~ /api/v1/outreach/ {
    if ($hid_outreach_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${OUTREACH_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }
  location = /api/v1/ehr {
    if ($hid_ehr_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${EHR_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }
  location ^~ /api/v1/ehr/ {
    location ~* ^/api/v1/ehr/internal(?:/|$) {
      add_header Cache-Control "no-store" always;
      return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}';
    }
    if ($hid_ehr_routes != on) { add_header Cache-Control "no-store" always; return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}'; }
    include /etc/nginx/hid-proxy-headers.conf;
    set $hid_upstream ${EHR_API_UPSTREAM};
    proxy_pass $hid_upstream;
  }
  location ^~ /api/ {
    default_type application/problem+json;
    add_header Cache-Control "no-store" always;
    return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ROUTE_NOT_FOUND"}';
  }

  location / {
    default_type application/problem+json;
    add_header Cache-Control "no-store" always;
    return 404 '{"type":"about:blank","title":"Not found","status":404,"code":"API_ONLY_ORIGIN"}';
  }
}
